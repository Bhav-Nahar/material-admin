# material-admin
# Copy to .env.local (gitignored) and fill in. Everything under REQUIRED is
# checked at boot; the rest degrade to "that module is off" rather than crashing.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=
# Admin tokens are minted per-day from these via client_credentials — see
# lib/adminToken.js. There is no long-lived token to paste.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
MONGODB_URI=
MONGODB_DB=
# Shared secret every /cron/* route requires as x-cron-secret. Unset rejects
# every cron request rather than allowing them.
CRON_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
PORT=8081
ADMIN_CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_MAX=300
# Matches material-frontend/scripts/setup-product-model.mjs. material-backend
# still defaults to 2024-10; this service does catalogue work and needs the newer one.
SHOPIFY_API_VERSION=2026-01
SHOPIFY_STOREFRONT_TOKEN=
# Where POST /api/products/create activates a new variant's stock. Unset, the
# location HOLDING STOCK is resolved from the store and cached — on this store that
# is "Mumbai warehouse" (Shop location is empty everywhere). Set it to skip the
# lookup, or when two locations both hold stock and the order matters.
SHOPIFY_LOCATION_ID=
# Comma-separated publication NAMES that POST /api/products/:id/publish publishes to.
# Never "all": publications(first:250) and publicationsCount both under-report this
# store by one channel ("Microsoft Copilot"), so a publish-to-everything loop skips a
# live channel and reports success. See lib/productPublish.js.
SHOPIFY_PUBLICATION_NAMES=Online Store

# Product signals — GA4 funnel data via BigQuery
GCP_PROJECT_ID=
GA4_DATASET=
GOOGLE_APPLICATION_CREDENTIALS=

# Product image generation
GOOGLE_AI_API_KEY=

# Marketing automation
KLAVIYO_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Performance marketing
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=

# SEO
# Raw service-account JSON. That account must be a user on the Search Console
# property below. Unset simply turns GET /api/seo/gsc/queries into a 503.
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE=sc-domain:material.in
# Copy generation. Same provider and env name as the source service; the key falls
# back to GOOGLE_AI_API_KEY above. Unset means /generate returns derived copy only —
# meta title and description are a template over stored metafields and need no model.
TEXT_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Ceiling on how many products POST /api/seo/cron/seo-backfill scans per run.
SEO_BACKFILL_LIMIT=250
